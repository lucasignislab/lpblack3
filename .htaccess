# Hospedagem Hostinger (Apache) — substitui o netlify.toml

DirectoryIndex index.html

# Rotas limpas: /qualificacao -> /qualificacao.html, /obrigado -> /obrigado.html etc.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Marca requisições de /assets/* para cache longo (usado pelo mod_headers abaixo)
  RewriteRule ^assets/ - [E=CACHE_ASSET:1]

  # Se não existir arquivo/pasta com o nome pedido, mas existir o .html, serve ele
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Cache imutável para assets (imagens, fontes, vídeo)
  Header set Cache-Control "public, max-age=31536000, immutable" env=CACHE_ASSET

  # Headers de segurança (equivalentes ao netlify.toml)
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://connect.facebook.net https://server.ratoeiraadsoficial.com.br https://www.clarity.ms https://scripts.clarity.ms https://googleads.g.doubleclick.net https://www.googleadservices.com; connect-src 'self' https://n8n.srv1145908.hstgr.cloud https://server.ratoeiraadsoficial.com.br https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://analytics.google.com https://stats.g.doubleclick.net https://www.google.com https://www.google.com.br https://www.facebook.com https://connect.facebook.net https://*.clarity.ms https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com https://mpc-prod-27-s6uit34pua-uk.a.run.app https://5z-2b6b7616f94640c2840d1841e1ac24c3.ecs.us-east-1.on.aws; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com https://www.google.com https://www.google.com.br https://googleads.g.doubleclick.net https://www.facebook.com https://server.ratoeiraadsoficial.com.br https://*.clarity.ms; frame-src https://www.googletagmanager.com https://server.ratoeiraadsoficial.com.br https://td.doubleclick.net https://www.facebook.com; style-src 'self' 'unsafe-inline'; form-action 'self' https://www.facebook.com; base-uri 'self'; frame-ancestors 'none'"
</IfModule>
